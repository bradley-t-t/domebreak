{
  "name": "goldendome",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GoldenDome - online multiplayer missile defense/offense game.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "electron": "electron .",
    "electron:build:mac": "vite build && electron-builder --mac",
    "electron:build:win": "vite build && electron-builder --win",
    "electron:build:all": "vite build && electron-builder -mw"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "flag-icons": "^7.5.0",
    "maplibre-gl": "^5.19.0",
    "pmtiles": "^4.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-map-gl": "^8.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "vite": "^7.3.2",
    "vitest": "^4.1.9"
  },
  "build": {
    "appId": "com.trentontaylor.goldendome",
    "productName": "GoldenDome",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png"
    }
  },
  "author": "Trenton Taylor",
  "homepage": "https://github.com/bradley-t-t/goldendome",
  "repository": {
    "type": "git",
    "url": "https://github.com/bradley-t-t/goldendome.git"
  }
}
